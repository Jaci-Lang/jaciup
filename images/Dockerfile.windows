# Jaci/Luau runner image (Windows) -- engine-only bootstrap.
#
# The `jaciup` version manager does NOT publish a Windows artifact yet, so this
# image cannot use the rustup pattern for Windows. Instead it downloads the
# `jaci` engine (luau) directly from the releases API. When a Windows `jaciup`
# artifact exists, switch this file to the same flow as Dockerfile.ubuntu
# (download jaciup, run `jaciup toolchain install`).
#
# Build:  DOCKER_BUILDKIT=1 docker build -f images/Dockerfile.windows -t jaci/jaci:0.310 .
# Pin the toolchain: pass --build-arg TOOLCHAIN_VERSION=0.310.0 (default: latest).

ARG BASE_IMAGE=ghcr.io/actions/runner:windows-2022
FROM ${BASE_IMAGE}

ARG TOOLCHAIN_VERSION=latest
ARG JACI_PRODUCT=jaci
ARG REGISTRY_URL=https://pop.squareweb.app

# 1. Download the jaci engine (luau) directly from the releases API.
#    Invoke-RestMethod returns .assets[]; the download_url is relative and must
#    be joined to the registry base to become fetchable.
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

RUN set -eux; \
    $json = Invoke-RestMethod -Uri "${REGISTRY_URL}/v1/releases/${TOOLCHAIN_VERSION}?product=${JACI_PRODUCT}"; \
    $asset = $json.assets | Where-Object { $_.name -eq "luau-x86_64-pc-windows-msvc.zip" } | Select-Object -First 1; \
    if (-not $asset) { throw "Could not resolve jaci engine artifact for x86_64-pc-windows-msvc" }; \
    $url = "${REGISTRY_URL}" + $asset.download_url; \
    Invoke-WebRequest -Uri $url -OutFile "C:\luau.zip"; \
    Expand-Archive -Path "C:\luau.zip" -DestinationPath "C:\luau" -Force; \
    Copy-Item "C:\luau\luau.exe" "C:\Program Files\Jaci\luau.exe" -Force; \
    Remove-Item -Path "C:\luau", "C:\luau.zip" -Recurse -Force; \
    C:\Program Files\Jaci\luau.exe --version

# 2. Persist the location on PATH for every future container run.
ENV PATH="C:\Program Files\Jaci;${PATH}"
