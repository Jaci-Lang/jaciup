# Jaci/Luau runner image (macOS) -- engine-only bootstrap.
#
# The `jaciup` version manager does NOT publish a macOS artifact yet, so this
# image cannot use the rustup pattern for macOS. Instead it downloads the
# `jaci` engine (luau) directly from the releases API. When a macOS `jaciup`
# artifact exists, switch this file to the same flow as Dockerfile.ubuntu
# (download jaciup, run `jaciup toolchain install`).
#
# Build:  DOCKER_BUILDKIT=1 docker build -f images/Dockerfile.macos -t jaci/jaci:0.310 .
# Pin the toolchain: pass --build-arg TOOLCHAIN_VERSION=0.310.0 (default: latest).
#
# NOTE: Docker cannot run macOS containers. For macOS this is used as the base
# for a self-hosted runner image (build via a Mac mini / macOS build host), or
# as a reference for the equivalent steps in a non-Docker setup.

ARG BASE_IMAGE=ghcr.io/actions/runner:ubuntu-24.04
FROM ${BASE_IMAGE}

ARG TOOLCHAIN_VERSION=latest
ARG JACI_PRODUCT=jaci
ARG REGISTRY_URL=https://pop.squareweb.app

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates unzip jq; \
    rm -rf /var/lib/apt/lists/*

# 1. Download the jaci engine (luau) directly from the releases API.
RUN set -eux; \
    REL="${REGISTRY_URL}/v1/releases/${TOOLCHAIN_VERSION}?product=${JACI_PRODUCT}"; \
    DL=$(curl -fsSL "$REL" | jq -r '.assets[] | select(.name=="luau-x86_64-apple-darwin.zip") | .download_url'); \
    if [ -z "$DL" ] || [ "$DL" = "null" ]; then \
        echo "Could not resolve jaci engine artifact for x86_64-apple-darwin"; \
        exit 1; \
    fi; \
    curl -fSL --retry 3 -o /tmp/luau.zip "${REGISTRY_URL}${DL}"; \
    unzip -o -q /tmp/luau.zip -d /tmp/luau; \
    chmod +x /tmp/luau/*; \
    install -m 0755 /tmp/luau/luau /usr/local/bin/luau; \
    rm -rf /tmp/luau /tmp/luau.zip

RUN set -eux; \
    command -v luau; \
    luau --version
